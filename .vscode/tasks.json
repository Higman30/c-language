{
    // =====================================================
    //  🧠 共通ビルドタスク (C17対応)
    //  ~/Desktop/c-language 配下のどの chapter でも動作
    // =====================================================
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clang build & run",
            "type": "shell",
            // アクティブなファイルを自動ビルド＆実行
            "command": "clang",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build active C file with clang (C17)",
            "label": "clang build only"
        },
        {
            "label": "clang run",
            "type": "shell",
            // 上でビルドしたファイルを実行
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": ["clang build only"],
            "problemMatcher": []
        }
    ]
}